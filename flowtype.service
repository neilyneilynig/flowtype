[Unit]
Description=flowtype push-to-talk dictation
After=graphical-session.target pipewire.service
PartOf=graphical-session.target

[Service]
# point this at the python3 that has faster-whisper installed
ExecStart=/usr/bin/python3 %h/.local/bin/flowtype daemon
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
